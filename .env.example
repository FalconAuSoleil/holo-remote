# Copier en .env à la racine.

# Relais (serveur public ou sur le PC)
PORT=3200
# Relais Node privé : jeton que le PC présente. Laisser vide pour un relais public (avec quotas).
# RELAY_TOKEN=
GLADIA_API_KEY=
GLADIA_LANGUAGE=fr

# Agent (PC)
# Relais public de la démo (aucun jeton nécessaire) :
RELAY_URL=wss://pilote.pro-max-lucas.workers.dev
# Relais local : ws://127.0.0.1:3200
# SESSION_ID=            # sinon tirée au hasard et affichée au démarrage
HOLO_BASE_URL=http://127.0.0.1:8000/v1
HOLO_MODEL=Hcompany/Holo1.5-7B
LINKUP_API_KEY=
MAX_STEPS=30
